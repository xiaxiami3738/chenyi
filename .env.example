# 运行模式：demo（默认，无需任何 Key，使用 FakeLLM 预置内容）| live（访客自带 Key）
APP_MODE=demo

# SQLite 数据库位置（容器内为 /app/data/app.db）
DB_PATH=data/app.db

# 防护参数
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=120
MAX_INPUT_CHARS=8000

# 注意：本项目绝不接受把 LLM Key 写进环境变量或文件。
# 访客的 Key 只存在于其浏览器 localStorage，并在单次请求中通过请求头透传，用完即弃。