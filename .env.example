# 运行模式：demo（默认，无需任何 Key，使用 FakeLLM 预置内容）| live（访客自带 Key）
APP_MODE=demo

# SQLite 数据库位置（容器内为 /app/data/app.db）
DB_PATH=data/app.db

# 防护参数
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=120
MAX_INPUT_CHARS=8000

# 注意：本项目绝不接受把访客的 LLM Key 写进环境变量或文件。
# 访客的 Key 只存在于其浏览器 localStorage，并在单次请求中通过请求头透传，用完即弃。

# 可选（M7.3）：服务端加密代存主密钥。留空则代存功能关闭。
# 仅当 APP_MODE=live 且走 HTTPS 时访客才能启用代存；此变量本身不是访客的 Key，
# 而是用来把访客 Key 加密后才落库的服务器端主密钥（Fernet）。请用随机长串：
#   openssl rand -base64 32
# VAULT_MASTER_KEY=